# ========================================
# E-LOGBOOK ENVIRONMENT VARIABLES
# ========================================

# ==================== GEMINI AI API ====================
# Generate API Key baru di: https://makersuite.google.com/app/apikey
# Panduan lengkap: Lihat file GENERATE_API_KEY.md
GEMINI_API_KEY=YOUR_API_KEY_HERE

# Base URL untuk Gemini API (jangan diubah)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Model yang digunakan (pilih salah satu):
# - gemini-1.5-flash (recommended: cepat & efisien)
# - gemini-1.5-pro (lebih akurat tapi lambat)
GEMINI_MODEL=gemini-1.5-flash

# ==================== BACKEND API ====================
# URL backend API server
API_BASE_URL=https://elogbookipb.web.id/api

# ==================== WEATHER API ====================
# OpenWeather API Key (optional)
OPENWEATHER_API_KEY=your_openweather_key_here

# ==================== GOOGLE MAPS API ====================
# Google Maps API Key (optional)
GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# ========================================
# NOTES:
# - Jangan commit file .env ke Git!
# - File ini sudah ada di .gitignore
# - Copy file ini ke .env dan isi dengan API Key yang valid
# - Restart aplikasi setelah mengubah .env
# ========================================
