# ========================================
# E-LOGBOOK ENVIRONMENT VARIABLES
# ========================================
# 
# PENTING: File ini adalah TEMPLATE!
# 
# CARA SETUP:
# 1. Copy file ini menjadi ".env"
# 2. Isi dengan API key PRIBADI Anda
# 3. JANGAN commit file .env ke Git!
#
# ========================================

# ========================================
# BACKEND API
# ========================================
API_BASE_URL=https://elogbookipb.web.id/api

# ========================================
# GEMINI AI (Fish Detection)
# ========================================
# Generate API key di: https://aistudio.google.com/app/apikey
# WAJIB: Setiap developer generate key SENDIRI!
GEMINI_API_KEY=YOUR_PERSONAL_API_KEY_HERE
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash

# ========================================
# GOOGLE MAPS API
# ========================================
# Generate di: https://console.cloud.google.com/google/maps-apis
# 
# ✅ WAJIB Enable 5 API ini (CUKUP untuk tampilan seperti Google Maps asli):
# 
# 1. Maps SDK for Android ⭐ WAJIB
#    → Tampilan peta interaktif (SUDAH INCLUDE: satellite, traffic, 3D, dll)
#    → Ini yang bikin tampilan PERSIS Google Maps asli!
# 
# 2. Maps SDK for iOS ⭐ WAJIB (jika ada iOS)
#    → Sama seperti Android tapi untuk iOS
# 
# 3. Geocoding API ⭐ WAJIB
#    → Convert koordinat GPS ↔ alamat
#    → Contoh: -6.123, 106.456 → "Pelabuhan Muara Baru"
# 
# 4. Directions API ⭐ PENTING
#    → Hitung rute perjalanan kapal
#    → Tampilkan garis rute di peta
# 
# 5. Roads API ⭐ PENTING
#    → Snap GPS ke jalur yang benar (tracking lebih akurat)
#    → GPS kapal yang bergerak di laut

# 💡 Maps SDK for Android = Google Maps asli di mobile!
#    Semua fitur visual (satellite, traffic, 3D) sudah include!
# 
# WAJIB: Setiap developer generate key SENDIRI!
GOOGLE_MAPS_API_KEY=YOUR_PERSONAL_GOOGLE_MAPS_KEY_HERE

# ========================================
# OPENWEATHER API (Weather Info)
# ========================================
# Generate di: https://openweathermap.org/api
# Free tier: 1000 calls/day
OPENWEATHER_API_KEY=YOUR_OPENWEATHER_KEY_HERE

# ========================================
# SECURITY NOTES:
# ========================================
# ⚠️ JANGAN PERNAH:
#   - Commit file .env ke Git
#   - Share API key ke orang lain
#   - Screenshot API key
#   - Paste API key di chat/email
#
# ✅ LAKUKAN:
#   - Setiap developer generate key sendiri
#   - Simpan key di password manager
#   - Rotate key secara berkala
# ========================================
